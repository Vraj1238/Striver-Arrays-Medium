//Brute
//TC :- O(N*N)           SC :- O(1)
int stock_buy_sell(vector<int> &arr, int n){
    int maxProfit = 0;
    for(int i=0;i<n;i++){
        int profit = 0;
        for(int j=i+1;j<n;j++){
            profit = arr[j] - arr[i];
            maxProfit = max(maxProfit,profit);
        }
    }
    return maxProfit;
}
//Better 
//TC :- O(2N)           SC :- O(N)
int stock_buy_sell_1(vector<int> &arr, int n){
    vector<int> prefixMin(n);
    prefixMin[0] = arr[0];
    // Find minimum price up to each index
    for(int i = 1; i < n; i++){
        prefixMin[i] = min(prefixMin[i - 1], arr[i]);
    }
    int maxProfit = 0;
    // Calculate profit for each selling day
    for(int i = 1; i < n; i++){
        int profit = arr[i] - prefixMin[i - 1];
        maxProfit = max(maxProfit, profit);
    }
    return maxProfit;
}
//Optimal
//TC :- O(N)           SC :- O(1)
int stock_buy_sell_2(vector<int> &prices,int n){
    int mini = prices[0];
    int maxProfit = 0;
    for(int i = 1; i < n; i++){
        int profit = prices[i] - mini;

        maxProfit = max(maxProfit, profit);

        mini = min(mini, prices[i]);
    }
    return maxProfit;
}
int main() {
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    cout << stock_buy_sell_1(arr, n);
}
