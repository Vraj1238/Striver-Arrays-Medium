//Brute
//TC :- O(N*N)           SC :- O(1)
void leader(vector<int> &arr,int n){
    int print;
    for(int i=0;i<n-1;i++){
        for(int j=i+1;j<n;j++){
            print = 1;
            if(arr[i] <= arr[j]){
                print = 0;
                break;
            } 
        }
        if(print == 1) cout << arr[i] << " ";
    }
    cout << arr[n-1];
}
