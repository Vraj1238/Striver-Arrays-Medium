//Brute
//TC :- O(mn * (m+n)) + O(mn)        SC :- O(1)
void markRow(vector<vector<int>> &arr, int i, int n) {
    for(int j = 0; j < n; j++) {
        if(arr[i][j] != 0) {
            arr[i][j] = -1;
        }
    }
}
void markCol(vector<vector<int>> &arr, int j, int m) {
    for(int i = 0; i < m; i++) {
        if(arr[i][j] != 0) {
            arr[i][j] = -1;
        }
    }
}
void set_matrix_zero(vector<vector<int>> &arr, int m, int n) {
    // Mark rows(m) and columns(n)
    //i => m
    //j => n
    //O(m*n ..)
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            if(arr[i][j] == 0) {
                //O(n)
                markRow(arr, i, n);
                //O(m)
                markCol(arr, j, m);
            }
        }
    }
    // Convert marked elements(-1) to 0
    //O(m*n)
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            if(arr[i][j] == -1) {
                arr[i][j] = 0;
            }
        }
    }
}
//Better
//TC :- O(2mn)        SC :- O(m+n)
void set_matrix_zero_1(vector<vector<int>> &arr, int m, int n){
    //Row array(m elements)
    vector<int> row(m, 0);  //int row[m] = {0}

    //Col array(n elements)
    vector<int> col(n, 0);  //int col[n] = {0}

    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            if(arr[i][j] == 0){
                row[i] = 1;
                col[j] = 1;
            }
        }
    }
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            if(row[i] == 1 || col[j] == 1){     //if(row[i] || col[j]) 0,1 can act as boolean walue
                arr[i][j] = 0;
            }
        }
    }
}
//Optimal
//TC :- O(2mn)        SC :- O(1)
void set_matrix_zero_2(vector<vector<int>> &matrix, int m, int n) {
    //int row[m] = {0} => matrix [..][0];
    //int col[n] = {0} => matrix [0][..];
    int col0 = 1;

    // Step 1: Mark rows and columns
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {

            if(matrix[i][j] == 0) {     //matrix / arr is same(basically name hai)

                // Mark the i-th row
                matrix[i][0] = 0;

                // Mark the j-th column
                if(j != 0)
                    matrix[0][j] = 0;
                else
                    col0 = 0;
            }
        }
    }

    // Step 2: Set inner matrix to zero
    for(int i = 1; i < m; i++) {
        for(int j = 1; j < n; j++) {

            if(matrix[i][j] != 0) {

                if(matrix[0][j] == 0 || matrix[i][0] == 0) {
                    matrix[i][j] = 0;
                }
            }
        }
    }

    // Step 3: Handle first row
    if(matrix[0][0] == 0) {
        for(int j = 0; j < n; j++) {
            matrix[0][j] = 0;
        }
    }

    // Step 4: Handle first column
    if(col0 == 0) {
        for(int i = 0; i < m; i++) {
            matrix[i][0] = 0;
        }
    }
}
int main() {
    int m, n;
    cin >> m >> n;
    //Array of n elements and There are m such arrays 
    vector<vector<int>> arr(m, vector<int>(n));
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            cin >> arr[i][j];
        }
    }
    set_matrix_zero_2(arr, m, n);
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            cout << arr[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}
