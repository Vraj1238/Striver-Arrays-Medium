//Better
//TC :- O(2N)              SC :- O(1)
void sort_012_1(vector<int> &arr, int n){
    int count_0 = 0;
    int count_1 = 0;
    int count_2 = 0;
    for(int i = 0; i < n; i++){
        if(arr[i] == 0) count_0++;
        else if(arr[i] == 1) count_1++;
        else count_2++;
    }
    for(int i = 0; i < count_0; i++)
        arr[i] = 0;
    for(int i = count_0; i < count_0 + count_1; i++)
        arr[i] = 1;
    for(int i = count_0 + count_1; i < n; i++)
        arr[i] = 2;
}
//Optimal (Dutch National Flag Algorithm)
//TC :- O(N)              SC :- O(1)
void sort_012_2(vector<int> &arr, int n){
    int low = 0;
    int mid = 0;
    int high = n-1;
    while(mid <= high){
        if(arr[mid] == 0){
            swap(arr[low],arr[mid]);
            low++;
            mid++;
        }
        else if(arr[mid] == 1){
            mid++;
        }
        else{
            swap(arr[mid],arr[high]);
            high--;
        }
    }
}
//My Solution 
//TC :- O(2N)              SC :- O(1)
void sort_012_3(vector<int> &arr, int n){
    unordered_map<int, int> mpp;
    for(int i = 0; i < n; i++){
        mpp[arr[i]]++;
    }
    int index = 0;
    for(int i = 0; i < mpp[0]; i++)
        arr[index++] = 0;
    for(int i = 0; i < mpp[1]; i++)
        arr[index++] = 1;
    for(int i = 0; i < mpp[2]; i++)
        arr[index++] = 2;
}
int main() {
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    sort_012_3(arr, n);
    for(int i = 0; i < n; i++) {
        cout <<  arr[i] << " ";
    }
}
