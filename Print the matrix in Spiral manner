//Optimal
//TC :- O(m*n)                 SC :- O(1) and if you count storing elements O(m*n)
vector<int> spiral_Matrix(vector<vector<int>> &mat, int m, int n) {

    int left = 0, right = n - 1;
    int top = 0, bottom = m - 1;

    vector<int> ans;

    while(top <= bottom && left <= right) {

        // 1. Left → Right
        for(int j = left; j <= right; j++) {
            ans.push_back(mat[top][j]);
        }
        top++;

        // 2. Top → Bottom
        for(int i = top; i <= bottom; i++) {
            ans.push_back(mat[i][right]);
        }
        right--;

        // 3. Right → Left
        if(top <= bottom) {
            for(int j = right; j >= left; j--) {
                ans.push_back(mat[bottom][j]);
            }
            bottom--;
        }

        // 4. Bottom → Top
        if(left <= right) {
            for(int i = bottom; i >= top; i--) {
                ans.push_back(mat[i][left]);
            }
            left++;
        }
    }
    return ans;
}
int main() {
    int m, n;
    cin >> m >> n;
    // m rows and n columns
    vector<vector<int>> arr(m, vector<int>(n));
    for(int i = 0; i < m; i++) {
        for(int j = 0; j < n; j++) {
            cin >> arr[i][j];
        }
    }
    vector<int> ans = spiral_Matrix(arr, m, n);
    for(int i = 0; i < ans.size(); i++) {
        cout << ans[i] << " ";
    }
    return 0;
}
