//Better
//TC :- O(NlogN) / O(N)  + O(N)           SC :- O(N)
int majority_element(vector<int> &arr,int n){
    unordered_map<int,int> mpp;
    for(int i=0;i<n;i++){
        mpp[arr[i]]++;
    }
    for(auto it: mpp){
        if(it.second > n/2)
            return it.first;
    }
    return -1;
}
//Optimal (Moore's Voting Algorithm)
//TC :- O(N)           SC :- O(1)
int majority_element_1(vector<int> &arr,int n){
    int el;
    int count = 0;
    for(int i=0;i<n;i++){
        if(count == 0){
            count = 1;
            el = arr[i];
        }
        else if(arr[i] == el){
            count++;
        }
        else{
            count--;
        }
    }
    int count_1 = 0;
    //Cross check like counting the answers frequency linearly
    for(int i=0;i<n;i++){
        if(arr[i] == el)    count_1++;
    }
    if(count_1 > (n/2)){     
        return el;
    }
    return -1;
}
int main() {
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    cout << majority_element_1(arr, n);
}
