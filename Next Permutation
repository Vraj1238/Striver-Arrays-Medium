//Optimal
//TC :- O(3N)           SC :- O(1)   
vector<int> next_permutation(vector<int> &arr, int n){
    int index = -1;
    //[2,1,5,4,3,0,0]
    for(int i=n-2;i>=0;i--){
        if(arr[i] < arr[i+1]){
            index = i;
            break;
        }
    }
    //[5,4,3,2,1] => [1,2,3,4,5]
    if(index == -1){
        reverse(arr.begin(),arr.end());
        return arr;
    }
    //Start from last as it is in decresing order
    //[2,1,5,4,3,0,0]    index = 1
    for(int i=n-1;i>=index;i--){
        if(arr[i] > arr[index]){
            swap(arr[i],arr[index]);
            break;
        }
    }
    //[2,3,5,4,1,0,0]    already in decreasng order
    reverse(arr.begin()+index+1,arr.end());
    //[2,3,0,0,1,4,5]
    return arr;

}
int main() {
    int n;
    cin >> n;
    vector<int> arr(n);
    for(int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    arr = next_permutation(arr, n);
    for(int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
}
